# Only needed for local development. The GitHub Action fills these in automatically.
NEXT_PUBLIC_GITHUB_REPO=owner/repo-name
NEXT_PUBLIC_GITHUB_BRANCH=main
NEXT_PUBLIC_BASE_PATH=

# Optional: free Web3Forms access key so the contact form sends without opening a mail app.
NEXT_PUBLIC_WEB3FORMS_KEY=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
